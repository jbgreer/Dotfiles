# First section: remote IMAP account
IMAPAccount fastmail
Host imap.fastmail.com
Port 993
User jbgreer@grimjeer.com
AuthMech LOGIN
PassCmd "op item get 5czktcki6xd6gms4q3v6daonh4 --reveal --fields password"
TLSType IMAPS
TLSVersions +1.3
CertificateFile /opt/homebrew/etc/ca-certificates/cert.pem

IMAPStore fastmail-remote
Account fastmail

# This section describes the local storage
MaildirStore fastmail-local
Path ~/Maildir/
Inbox ~/Maildir/INBOX
# The SubFolders option allows to represent all
# IMAP subfolders as local subfolders
SubFolders Verbatim

# This section a "channel", a connection between remote and local
Channel fastmail
Far :fastmail-remote:
Near :fastmail-local:
Patterns *
Expunge None
CopyArrivalDate yes
Sync All
Create Near
SyncState *
