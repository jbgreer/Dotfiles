[alias]
	amend = "commit -a --amend"
	co = "checkout"
	undo = "reset HEAD~1 --mixed"

[branch]
  sort = -committerdate

[column]
  ui = auto 

[commit]
	gpgsign = true
  verbose = true

[diff]
  algorithm = histogram
  colorMoved = plain
  mnemonicPrefix = true
  renames = true

[fetch]
  prune = true
  pruneTags = true
  all = true

[help]
  autocorrect = prompt

[init]
	defaultBranch = main
  sort = version:refname

[push]
  default = simple
  autoSetupRemote = true
  followTags = true

[rebase]
  autoSquash = true
  autoStash = true
  updateRefs = true

[rerere]
  enabled = true
  autoupdate = true

[tag]
	gpgsign = true

[user]
	email = "jbgreer@gmail.com"
	name = "Jim Greer"
	signingkey = /Users/jbgreer/.ssh/id_ed25519.pub
[gpg]
	format = ssh
[gpg "ssh"]
	allowedSignersFile = /Users/jbgreer/.ssh/allowed_signers
[format]
	signoff = true
