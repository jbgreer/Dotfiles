# Set default values for all the accounts.
defaults
auth on
protocol smtp
tls on
tls_trust_file /opt/homebrew/etc/ca-certificates/cert.pem
logfile ~/Maildir/msmtp.log

# Account details for jbgreer@grimjeer.com
account fastmail
host smtp.fastmail.com
port 587
from jbgreer@grimjeer.com
user jbgreer@grimjeer.com
passwordeval op item get 5czktcki6xd6gms4q3v6daonh4 --reveal --fields password
# tls_starttls off

# Default
account default : fastmail
