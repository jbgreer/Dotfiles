    echo >&2 "If you are using the daemon:"
    echo >&2
    echo >&2 "    sudo chown -R root:wheel /nix/var/nix/db"
    echo >&2
    echo >&2 "Otherwise:"
    echo >&2
    echo >&2 "    sudo chown -R $USER:staff /nix/store"
    echo >&2
